{
  "schema_version": "workflow_package.v1",
  "id": "com.himind.workflow.exhibit-development",
  "version": "0.3.0",
  "distribution_targets": [
    "workbench",
    "github"
  ],
  "name": "展项开发",
  "description": "导入展项脚本，确认开发规格，结合 UNIHPer 约束完成开发，并同步可检索的截图、视频或测试证据。",
  "release_notes": "0.3.0：开发步骤前置 MCP 就绪检查与工程启动，依赖 Skill 提升到展项 0.2.0、UNIHper 1.3.0。",
  "min_agent_version": "0.3.90",
  "execution_policy": "segmented",
  "entrypoints": [
    {
      "id": "script_sync",
      "at_step": "EX-SCRIPT-PARSE",
      "label": "从本地脚本开始",
      "requires": []
    },
    {
      "id": "development",
      "at_step": "EX-DEVELOP",
      "label": "继续开发",
      "requires": [
        "exhibit-spec"
      ]
    }
  ],
  "default_entrypoint": "script_sync",
  "exits": [
    {
      "id": "intro_published",
      "at_step": "EX-INTRO-PUBLISH",
      "label": "展项介绍已同步",
      "produces": [
        "exhibit-intro"
      ]
    },
    {
      "id": "spec_confirmed",
      "at_step": "EX-SPEC-PUBLISH",
      "label": "规格已发布",
      "produces": [
        "exhibit-intro",
        "exhibit-spec"
      ]
    },
    {
      "id": "development_checkpoint",
      "at_step": "EX-REVIEW",
      "label": "开发证据已验收",
      "produces": [
        "development-checkpoint",
        "evidence-manifest"
      ]
    }
  ],
  "default_exitpoint": "development_checkpoint",
  "capabilities": [
    "exhibit.script.parse",
    "workbench.exhibit.intro.update",
    "workbench.exhibit.spec.publish",
    "exhibit.project.inspect",
    "exhibit.evidence.pack",
    "workbench.exhibit.artifact.upload",
    "workbench.exhibit.artifact.list"
  ],
  "dependencies": {
    "skills": [
      {
        "id": "com.himind.skill.exhibit-development",
        "required": true,
        "min_version": "0.2.0"
      },
      {
        "id": "com.mrbaoquan.skill.unihper-unity-development",
        "required": true,
        "min_version": "1.3.0"
      }
    ],
    "plugins": [
      {
        "id": "com.himind.exhibit-development-tools",
        "required": true,
        "min_version": "0.6.0"
      }
    ],
    "connectors": [],
    "runtimes": [
      "codex",
      "himind.builtin"
    ]
  },
  "steps": [
    {
      "id": "EX-SCRIPT-PARSE",
      "title": "本地解析脚本结构",
      "kind": "capability",
      "capability_id": "exhibit.script.parse",
      "execution_mode": "sync",
      "risk_level": "read_only",
      "input": {
        "script_path": "input.script_path"
      }
    },
    {
      "id": "EX-INTRO-DRAFT",
      "title": "生成 Markdown 展项介绍",
      "kind": "runtime",
      "execution_mode": "sync",
      "risk_level": "read_only",
      "depends_on": [
        "EX-SCRIPT-PARSE"
      ],
      "runtime": {
        "provider": "auto",
        "prompt": "使用 $exhibit-development 读取 workflow_context 中的本地脚本解析结果，生成面向业务人员的 Markdown 展项介绍。只保留业务介绍、硬件、体验流程、交互状态和待确认项；不得写入本机绝对路径。输出严格符合 result_schema，并包含 source_name、source_sha256、model、prompt_version。",
        "result_schema": "artifacts/exhibit-intro.schema.json",
        "tool_policy": "default",
        "allow_network": true,
        "timeout_seconds": 900
      }
    },
    {
      "id": "EX-INTRO-PUBLISH",
      "title": "同步展项介绍到工作台",
      "kind": "runtime",
      "execution_mode": "sync",
      "risk_level": "network_write",
      "approval_required": true,
      "depends_on": [
        "EX-INTRO-DRAFT"
      ],
      "runtime": {
        "provider": "auto",
        "prompt": "用户已确认将本地脚本解读结果写入工作台。使用 $exhibit-development，调用 workbench.exhibit.intro.update，将 workflow_context.steps[\"EX-INTRO-DRAFT\"] 中的 content_markdown、source_name、source_sha256、model、prompt_version 写回当前展项。不得上传脚本文件或本机绝对路径。返回严格符合 result_schema。",
        "result_schema": "artifacts/exhibit-intro.schema.json",
        "tool_policy": "default",
        "allow_network": true,
        "timeout_seconds": 600
      }
    },
    {
      "id": "EX-SPEC-DRAFT",
      "title": "生成结构化开发规格",
      "kind": "runtime",
      "execution_mode": "sync",
      "risk_level": "read_only",
      "depends_on": [
        "EX-INTRO-PUBLISH"
      ],
      "runtime": {
        "provider": "auto",
        "prompt": "使用 $exhibit-development 读取 workflow_context 中的本地脚本解析结果和已同步的 Markdown 介绍，生成 exhibit-development-spec.v1。每条需求必须有 requirement_id、source_ref、acceptance 和 evidence；不确定内容进入 unknowns，不得臆造。source_script 只记录本地源文件名与 SHA-256，不包含本机绝对路径或工作台脚本版本。输出严格符合 result_schema。",
        "result_schema": "artifacts/exhibit-spec.schema.json",
        "tool_policy": "default",
        "allow_network": true,
        "timeout_seconds": 900
      }
    },
    {
      "id": "EX-SPEC-CONFIRM",
      "title": "确认开发规格",
      "kind": "manual",
      "execution_mode": "sync",
      "risk_level": "R2",
      "approval_required": true,
      "depends_on": [
        "EX-SPEC-DRAFT"
      ]
    },
    {
      "id": "EX-SPEC-PUBLISH",
      "title": "发布开发规格",
      "kind": "runtime",
      "execution_mode": "sync",
      "risk_level": "network_write",
      "approval_required": true,
      "depends_on": [
        "EX-SPEC-CONFIRM"
      ],
      "runtime": {
        "provider": "auto",
        "prompt": "用户已确认规格。使用 $exhibit-development，将 workflow_context.steps[\"EX-SPEC-DRAFT\"] 的规格内容通过 workbench.exhibit.spec.publish 发布到当前展项。source_script 使用本地脚本文件名与 SHA-256，不引用工作台脚本版本。返回已发布规格，严格符合 result_schema。",
        "result_schema": "artifacts/exhibit-spec.schema.json",
        "tool_policy": "default",
        "allow_network": true,
        "timeout_seconds": 600
      }
    },
    {
      "id": "EX-PROJECT-INSPECT",
      "title": "检查目标工程",
      "kind": "capability",
      "capability_id": "exhibit.project.inspect",
      "execution_mode": "sync",
      "risk_level": "read_only",
      "depends_on": [
        "EX-SPEC-PUBLISH"
      ],
      "input": {
        "project_root": "input.workspace_root"
      }
    },
    {
      "id": "EX-DEVELOP",
      "title": "按开发规格实现并验证",
      "kind": "runtime",
      "execution_mode": "long_running",
      "risk_level": "local_write",
      "depends_on": [
        "EX-PROJECT-INSPECT"
      ],
      "runtime": {
        "provider": "auto",
        "prompt": "使用 $exhibit-development 和 $unihper-unity-development，在当前展项工程中按已发布规格完成一个有界开发任务。开始前先确认 MCP 就绪：读心跳文件 %USERPROFILE%/.unity-mcp/unity-mcp-status-*.json，核对工程已打开、reloading 为 false、端口与 ProjectVersion 和客户端版本一致；工程未打开时按 ProjectSettings/ProjectVersion.txt 的版本启动对应 Unity 并等到就绪，MCP 不可用不得跳过验证。再读取工作区和规格，遵守 UNIHPer 生命周期；每次修改后编译、检查 Console、运行最小测试并对 UI/交互截图。不得提交、推送或发布。返回 DevelopmentCheckpoint，严格符合 result_schema。",
        "workspace_path": "input.workspace_root",
        "result_schema": "artifacts/development-checkpoint.schema.json",
        "tool_policy": "default",
        "allow_network": true,
        "timeout_seconds": 7200
      }
    },
    {
      "id": "EX-EVIDENCE-PACK",
      "title": "生成开发证据清单",
      "kind": "capability",
      "capability_id": "exhibit.evidence.pack",
      "execution_mode": "sync",
      "risk_level": "read_only",
      "depends_on": [
        "EX-DEVELOP"
      ],
      "when": {
        "operator": "not_equals",
        "path": "input.evidence_items",
        "value": []
      },
      "input": {
        "workspace_root": "input.workspace_root",
        "items": "input.evidence_items"
      }
    },
    {
      "id": "EX-EVIDENCE-UPLOAD",
      "title": "同步开发证据到工作台",
      "kind": "runtime",
      "execution_mode": "sync",
      "risk_level": "network_write",
      "approval_required": true,
      "depends_on": [
        "EX-EVIDENCE-PACK"
      ],
      "when": {
        "operator": "not_equals",
        "path": "input.evidence_items",
        "value": []
      },
      "input": {
        "exhibit_id": "input.exhibit_id",
        "local_path": "input.evidence_path",
        "request_key": "input.evidence_request_key",
        "artifact_kind": "input.evidence_kind",
        "checkpoint_id": "",
        "spec_revision": 0,
        "requirement_ids": [],
        "metadata": {
          "source": "exhibit-development-workflow"
        }
      },
      "runtime": {
        "provider": "auto",
        "prompt": "使用 $exhibit-development，读取 workflow_context.steps[\"EX-EVIDENCE-PACK\"] 的 Artifact 清单。对每个 artifact 调用 workbench.exhibit.artifact.upload，request_key 使用 exhibit_id、artifact_kind 和 sha256 生成稳定值；尽可能关联 EX-DEVELOP 返回的 checkpoint_id、当前规格 revision 和 requirement_ids。上传后调用 workbench.exhibit.artifact.list 按展项回读校验。不得上传原始脚本或本机绝对路径。返回严格符合 result_schema。",
        "result_schema": "artifacts/evidence-manifest.schema.json",
        "tool_policy": "default",
        "allow_network": true,
        "timeout_seconds": 1800
      }
    },
    {
      "id": "EX-REVIEW",
      "title": "人工验收开发结果",
      "kind": "manual",
      "execution_mode": "sync",
      "risk_level": "R2",
      "approval_required": true,
      "depends_on": [
        "EX-DEVELOP"
      ]
    }
  ],
  "artifacts": [
    {
      "id": "exhibit-intro",
      "artifact_type": "exhibit_intro",
      "name": "展项 Markdown 介绍",
      "schema": "artifacts/exhibit-intro.schema.json",
      "required": false,
      "validation": "strict",
      "max_bytes": 1048576
    },
    {
      "id": "exhibit-spec",
      "artifact_type": "exhibit_development_spec",
      "name": "展项开发规格",
      "schema": "artifacts/exhibit-spec.schema.json",
      "required": true,
      "validation": "strict",
      "max_bytes": 1048576
    },
    {
      "id": "development-checkpoint",
      "artifact_type": "development_checkpoint",
      "name": "开发检查点",
      "schema": "artifacts/development-checkpoint.schema.json",
      "required": true,
      "validation": "strict",
      "max_bytes": 1048576
    },
    {
      "id": "evidence-manifest",
      "artifact_type": "exhibit_evidence_manifest",
      "name": "开发证据清单",
      "schema": "artifacts/evidence-manifest.schema.json",
      "required": false,
      "validation": "strict",
      "max_bytes": 1048576
    }
  ],
  "ui": {
    "mode": "declarative",
    "surfaces": [
      "agent",
      "dashboard"
    ],
    "entry": "ui/workflow-view.json"
  },
  "supported_runtimes": [
    "codex",
    "himind.builtin"
  ],
  "created_at": "2026-10-26T00:00:00Z"
}
