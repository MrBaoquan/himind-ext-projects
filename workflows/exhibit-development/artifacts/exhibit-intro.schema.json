{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exhibit Intro",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_markdown",
    "source_name",
    "source_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "exhibit-intro.v1"
    },
    "content_markdown": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "source_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "model": {
      "type": "string",
      "maxLength": 255
    },
    "prompt_version": {
      "type": "string",
      "maxLength": 255
    }
  }
}
