{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AndX Custom Page Acceptance Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "page_url",
    "current_version",
    "artifact_sha256",
    "screenshots",
    "console_errors",
    "network_failures",
    "channels",
    "manual_approved",
    "ok"
  ],
  "properties": {
    "schema_version": {
      "const": "andx-custom-page-acceptance.v1"
    },
    "page_url": {
      "type": "string",
      "minLength": 1
    },
    "current_version": {
      "type": "string",
      "minLength": 1
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "screenshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "console_errors": {
      "type": "integer",
      "minimum": 0
    },
    "network_failures": {
      "type": "integer",
      "minimum": 0
    },
    "channels": {
      "type": "array",
      "items": {
        "enum": [
          "MINI_WEBVIEW",
          "WECHAT_BROWSER"
        ]
      }
    },
    "manual_approved": {
      "type": "boolean"
    },
    "notes": {
      "type": "string"
    },
    "ok": {
      "type": "boolean"
    }
  }
}
