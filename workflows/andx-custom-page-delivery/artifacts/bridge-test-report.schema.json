{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AndX Custom Page Bridge Test Report",
  "type": "object",
  "required": ["schema", "ok", "assertions"],
  "properties": {
    "schema": {"const": "andx-custom-page-bridge-test/v1"},
    "ok": {"type": "boolean"},
    "assertions": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "consoleErrors": {"type": "array", "items": {"type": "string"}},
    "exceptions": {"type": "array", "items": {"type": "string"}},
    "networkFailures": {"type": "array", "items": {"type": "string"}},
    "screenshotPath": {"type": "string"},
    "reportPath": {"type": "string"},
    "completedAt": {"type": "string"}
  },
  "additionalProperties": true
}