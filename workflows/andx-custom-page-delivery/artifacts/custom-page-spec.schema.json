{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AndX Custom Page Spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "page_key",
    "version",
    "display_mode",
    "build_provider",
    "source_root",
    "bridge",
    "requirements",
    "acceptance"
  ],
  "properties": {
    "schema_version": {
      "const": "andx-custom-page-spec.v1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "exhibit_id": {
      "type": "string"
    },
    "page_key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "display_mode": {
      "enum": [
        "embedded",
        "immersive"
      ]
    },
    "build_provider": {
      "enum": [
        "myriadbox",
        "external"
      ]
    },
    "source_root": {
      "type": "string",
      "minLength": 1
    },
    "bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "required_capabilities"
      ],
      "properties": {
        "version": {
          "const": "1.0"
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optional_capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "page_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    }
  }
}
